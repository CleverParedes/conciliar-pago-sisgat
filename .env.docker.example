@'
# ==================================================
# PUERTOS
# ==================================================

APP_PORT=3000
POSTGRES_HOST_PORT=5433

# ==================================================
# POSTGRESQL
# ==================================================

POSTGRES_DB=sistema_pagos
POSTGRES_USER=sistema_pagos_user
POSTGRES_PASSWORD=COLOCA_AQUI_UNA_CONTRASENA_POSTGRES

# ==================================================
# ADMINISTRADOR INICIAL
# ==================================================

ADMIN_NAME=Administrador del sistema
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sistema.local
ADMIN_PASSWORD=COLOCA_AQUI_UNA_CONTRASENA_SEGURA

# ==================================================
# SESIONES Y SEGURIDAD
# ==================================================

COOKIE_SECURE=false
SESSION_COOKIE_NAME=sistema_pagos_session
SESSION_HOURS=12
GUEST_SESSION_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ==================================================
# RESPALDOS
# ==================================================

BACKUP_RETENTION_COUNT=20
'@ | Set-Content ".\.env.docker.example" -Encoding UTF8