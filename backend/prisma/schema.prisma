generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoConciliacion {
  PENDIENTE
  PAGO_PARCIAL
  PAGADO
  SOBREPAGO
  SIN_DECLARACION
  PAGO_ANULADO
  ANULADO
  REVISAR
}

enum TipoImportacion {
  ORDENES
  LIQUIDACIONES
  REQUERIMIENTOS
  REQUERIMIENTOS_MANUALES
  PAGOS
  DECLARACIONES_PAGOS
}

enum ModoImportacion {
  HISTORICA
  INCREMENTAL
}

enum TipoFechaFiltro {
  NO_ESPECIFICADO
  FECHA_DECLARACION
  FECHA_RECIBO
  FECHA_CREACION
  FECHA_MODIFICACION
  CREACION_O_MODIFICACION
}

enum OrigenImportacion {
  MANUAL
  DRIVE
}

enum EstadoImportacion {
  PROCESANDO
  COMPLETADA
  COMPLETADA_CON_ERRORES
  FALLIDA
}

enum EstadoVersionDatos {
  PENDIENTE
  VALIDADA
  APLICANDO
  ACTIVA
  ARCHIVADA
  FALLIDA
  CANCELADA
}

enum TipoArchivoVersion {
  ORDENES
  DECLARACIONES_PAGOS
}


enum TipoRegistroManual {
  REGISTRO_COMPLETO
  INCOMPLETO
  VACIO
  SIN_REGISTRO
  ANULADO
}

enum EstadoConciliacionManual {
  PENDIENTE
  PAGO_PARCIAL
  PAGADO
  SIN_DECLARACION
  ANULADO
  NO_APLICA
  REVISAR
}

enum EstadoRevisionManual {
  PENDIENTE
  COINCIDE
  DISCREPANCIA
  REVISAR
  NO_APLICA
}

enum EstadoNotificacionManual {
  SIN_ASIGNAR
  ASIGNADO
  PENDIENTE_NOTIFICACION
  NOTIFICADO
  NO_NOTIFICADO
  OBSERVADO
}

model Contribuyente {
  id                Int      @id @default(autoincrement())
  codigo            String?  @unique @db.VarChar(40)
  tipoDocumento     String?  @map("tipo_documento") @db.VarChar(20)
  numeroDocumento   String?  @unique @map("numero_documento") @db.VarChar(30)
  nombreRazonSocial String   @map("nombre_razon_social") @db.VarChar(250)
  direccion         String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  ordenes        OrdenPago[]
  liquidaciones  Liquidacion[]
  requerimientos Requerimiento[]
  declaraciones  Declaracion[]

  @@index([nombreRazonSocial])
  @@map("contribuyentes")
}

model OrdenPago {
  id                Int                @id @default(autoincrement())
  anioOrden         Int                @map("anio_orden")
  numeroOrden       String             @map("numero_orden") @db.VarChar(60)
  idOrigen          String?            @map("id_origen") @db.VarChar(60)
  fechaEmision      DateTime?          @map("fecha_emision") @db.Date
  contribuyenteId   Int?               @map("contribuyente_id")
  dniRucOriginal    String?            @map("dni_ruc_original") @db.VarChar(30)
  nombreOriginal    String?            @map("nombre_original") @db.VarChar(250)
  direccionOriginal String?            @map("direccion_original")
  placa             String?            @db.VarChar(20)
  fechaSunarp       DateTime?          @map("fecha_sunarp") @db.Date
  activoOriginal    Int?               @map("activo_original")
  periodoOriginal   String?            @map("periodo_original")
  importeTotal      Decimal            @map("importe_total") @db.Decimal(14, 2)
  totalPagado       Decimal            @default(0) @map("total_pagado") @db.Decimal(14, 2)
  saldo             Decimal            @default(0) @db.Decimal(14, 2)
  estado            EstadoConciliacion @default(PENDIENTE)
  archivoOrigen     String?            @map("archivo_origen")
  filaOrigen        Int?               @map("fila_origen")
  datosOriginales   Json?              @map("datos_originales")
  importacionId     Int?               @map("importacion_id")
  versionDatosId    Int?               @map("version_datos_id")
  versionOrdenesId  Int?               @map("version_ordenes_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  contribuyente Contribuyente? @relation(fields: [contribuyenteId], references: [id], onDelete: SetNull)
  importacion   Importacion?   @relation(fields: [importacionId], references: [id], onDelete: SetNull)
  versionDatos   VersionDatos?   @relation(fields: [versionDatosId], references: [id], onDelete: SetNull)
  versionOrdenes VersionOrdenes? @relation(fields: [versionOrdenesId], references: [id], onDelete: SetNull)
  detalles      OrdenDetalle[]

  @@unique([anioOrden, numeroOrden])
  @@index([contribuyenteId])
  @@index([dniRucOriginal])
  @@index([placa])
  @@index([estado])
  @@index([anioOrden])
  @@index([importacionId])
  @@index([versionDatosId])
  @@index([versionOrdenesId])
  @@map("ordenes_pago")
}

model OrdenDetalle {
  id               Int                @id @default(autoincrement())
  ordenId          Int                @map("orden_id")
  declaracionId    Int?               @map("declaracion_id")
  periodoAnio      Int                @map("periodo_anio")
  periodoOriginal  String?            @map("periodo_original") @db.VarChar(50)
  trimestreDesde   Int                @map("trimestre_desde")
  trimestreHasta   Int                @map("trimestre_hasta")
  valorReferencial Decimal?           @map("valor_referencial") @db.Decimal(14, 2)
  anioFabricacion  Int?               @map("anio_fabricacion")
  uit              Decimal?           @db.Decimal(14, 2)
  baseImponible    Decimal?           @map("base_imponible") @db.Decimal(14, 2)
  impuesto         Decimal?           @db.Decimal(14, 2)
  reajuste         Decimal?           @db.Decimal(14, 2)
  interes          Decimal?           @db.Decimal(14, 2)
  gastosAdmin      Decimal?           @map("gastos_admin") @db.Decimal(14, 2)
  totalPeriodo     Decimal            @map("total_periodo") @db.Decimal(14, 2)
  montoPagado      Decimal            @default(0) @map("monto_pagado") @db.Decimal(14, 2)
  saldo            Decimal            @default(0) @db.Decimal(14, 2)
  estado           EstadoConciliacion @default(PENDIENTE)
  observacion      String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  orden       OrdenPago    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  declaracion Declaracion? @relation(fields: [declaracionId], references: [id], onDelete: SetNull)

  @@unique([ordenId, periodoAnio, trimestreDesde, trimestreHasta])
  @@index([ordenId])
  @@index([declaracionId])
  @@index([periodoAnio])
  @@index([estado])
  @@map("ordenes_detalle")
}

model Liquidacion {
  id                      Int                @id @default(autoincrement())
  anioLiquidacion         Int                @map("anio_liquidacion")
  numeroLiquidacion       String             @map("numero_liquidacion") @db.VarChar(60)
  idOrigen                String?            @map("id_origen") @db.VarChar(60)
  fechaEmision            DateTime?          @map("fecha_emision") @db.Date
  contribuyenteId         Int?               @map("contribuyente_id")
  dniRucOriginal          String?            @map("dni_ruc_original") @db.VarChar(30)
  nombreOriginal          String?            @map("nombre_original") @db.VarChar(250)
  direccionOriginal       String?            @map("direccion_original")
  placa                   String?            @db.VarChar(20)
  fechaSunarp             DateTime?          @map("fecha_sunarp") @db.Date
  estadoOriginal          String?            @map("estado_original") @db.VarChar(40)
  periodoOriginal         String?            @map("periodo_original")
  importeTotal            Decimal            @map("importe_total") @db.Decimal(14, 2)
  totalPagado             Decimal            @default(0) @map("total_pagado") @db.Decimal(14, 2)
  saldo                   Decimal            @default(0) @db.Decimal(14, 2)
  estado                  EstadoConciliacion @default(PENDIENTE)
  usuarioCreacion         String?            @map("usuario_creacion") @db.VarChar(100)
  fechaCreacionOrigen     DateTime?          @map("fecha_creacion_origen")
  usuarioModificacion     String?            @map("usuario_modificacion") @db.VarChar(100)
  fechaModificacionOrigen DateTime?          @map("fecha_modificacion_origen")
  fechaGeneracion         DateTime?          @map("fecha_generacion") @db.Date
  anioRVeh                Int?               @map("anio_r_veh")
  numeroRVeh              String?            @map("numero_r_veh") @db.VarChar(60)
  archivoOrigen           String?            @map("archivo_origen")
  filaOrigen              Int?               @map("fila_origen")
  datosOriginales         Json?              @map("datos_originales")
  importacionId           Int?               @map("importacion_id")
  versionLiquidacionesId  Int?               @map("version_liquidaciones_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  contribuyente        Contribuyente?        @relation(fields: [contribuyenteId], references: [id], onDelete: SetNull)
  importacion          Importacion?          @relation(fields: [importacionId], references: [id], onDelete: SetNull)
  versionLiquidaciones VersionLiquidaciones? @relation(fields: [versionLiquidacionesId], references: [id], onDelete: SetNull)
  detalles             LiquidacionDetalle[]

  @@unique([anioLiquidacion, numeroLiquidacion])
  @@index([contribuyenteId])
  @@index([dniRucOriginal])
  @@index([placa])
  @@index([estado])
  @@index([anioLiquidacion])
  @@index([importacionId])
  @@index([versionLiquidacionesId])
  @@map("liquidaciones")
}

model LiquidacionDetalle {
  id               Int                @id @default(autoincrement())
  liquidacionId    Int                @map("liquidacion_id")
  declaracionId    Int?               @map("declaracion_id")
  periodoAnio      Int                @map("periodo_anio")
  periodoOriginal  String?            @map("periodo_original") @db.VarChar(50)
  trimestreDesde   Int                @map("trimestre_desde")
  trimestreHasta   Int                @map("trimestre_hasta")
  valorReferencial Decimal?           @map("valor_referencial") @db.Decimal(14, 2)
  anioFabricacion  Int?               @map("anio_fabricacion")
  uit              Decimal?           @db.Decimal(14, 2)
  baseImponible    Decimal?           @map("base_imponible") @db.Decimal(14, 2)
  impuesto         Decimal?           @db.Decimal(14, 2)
  reajuste         Decimal?           @db.Decimal(14, 2)
  interes          Decimal?           @db.Decimal(14, 2)
  gastosAdmin      Decimal?           @map("gastos_admin") @db.Decimal(14, 2)
  totalPeriodo     Decimal            @map("total_periodo") @db.Decimal(14, 2)
  montoPagado      Decimal            @default(0) @map("monto_pagado") @db.Decimal(14, 2)
  saldo            Decimal            @default(0) @db.Decimal(14, 2)
  estado           EstadoConciliacion @default(PENDIENTE)
  observacion      String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  liquidacion Liquidacion  @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  declaracion Declaracion? @relation(fields: [declaracionId], references: [id], onDelete: SetNull)

  @@unique([liquidacionId, periodoAnio, trimestreDesde, trimestreHasta])
  @@index([liquidacionId])
  @@index([declaracionId])
  @@index([periodoAnio])
  @@index([estado])
  @@map("liquidaciones_detalle")
}


model Requerimiento {
  id                       Int                @id @default(autoincrement())
  anioRequerimiento        Int                @map("anio_requerimiento")
  numeroRequerimiento      String             @map("numero_requerimiento") @db.VarChar(60)
  idOrigen                 String?            @map("id_origen") @db.VarChar(60)
  fechaEmision             DateTime?          @map("fecha_emision") @db.Date
  contribuyenteId          Int?               @map("contribuyente_id")
  dniRucOriginal           String?            @map("dni_ruc_original") @db.VarChar(30)
  nombreOriginal           String?            @map("nombre_original") @db.VarChar(250)
  direccionOriginal        String?            @map("direccion_original")
  placa                    String?            @db.VarChar(20)
  fechaSunarp              DateTime?          @map("fecha_sunarp") @db.Date
  estadoOriginal           String?            @map("estado_original") @db.VarChar(40)
  periodoOriginal          String?            @map("periodo_original")
  importeTotal             Decimal            @map("importe_total") @db.Decimal(14, 2)
  totalPagado              Decimal            @default(0) @map("total_pagado") @db.Decimal(14, 2)
  saldo                    Decimal            @default(0) @db.Decimal(14, 2)
  estado                   EstadoConciliacion @default(PENDIENTE)
  usuarioCreacion          String?            @map("usuario_creacion") @db.VarChar(100)
  fechaCreacionOrigen      DateTime?          @map("fecha_creacion_origen")
  usuarioModificacion      String?            @map("usuario_modificacion") @db.VarChar(100)
  fechaModificacionOrigen  DateTime?          @map("fecha_modificacion_origen")
  fechaGeneracion          DateTime?          @map("fecha_generacion") @db.Date
  archivoOrigen            String?            @map("archivo_origen")
  filaOrigen               Int?               @map("fila_origen")
  datosOriginales          Json?              @map("datos_originales")
  importacionId            Int?               @map("importacion_id")
  versionRequerimientosId  Int?               @map("version_requerimientos_id")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  contribuyente         Contribuyente?         @relation(fields: [contribuyenteId], references: [id], onDelete: SetNull)
  importacion           Importacion?           @relation(fields: [importacionId], references: [id], onDelete: SetNull)
  versionRequerimientos VersionRequerimientos? @relation(fields: [versionRequerimientosId], references: [id], onDelete: SetNull)
  detalles              RequerimientoDetalle[]

  @@unique([anioRequerimiento, numeroRequerimiento])
  @@index([contribuyenteId])
  @@index([dniRucOriginal])
  @@index([placa])
  @@index([estado])
  @@index([anioRequerimiento])
  @@index([importacionId])
  @@index([versionRequerimientosId])
  @@map("requerimientos")
}

model RequerimientoDetalle {
  id               Int                @id @default(autoincrement())
  requerimientoId  Int                @map("requerimiento_id")
  declaracionId    Int?               @map("declaracion_id")
  periodoAnio      Int                @map("periodo_anio")
  periodoOriginal  String?            @map("periodo_original") @db.VarChar(50)
  trimestreDesde   Int                @map("trimestre_desde")
  trimestreHasta   Int                @map("trimestre_hasta")
  valorReferencial Decimal?           @map("valor_referencial") @db.Decimal(14, 2)
  anioFabricacion  Int?               @map("anio_fabricacion")
  uit              Decimal?           @db.Decimal(14, 2)
  baseImponible    Decimal?           @map("base_imponible") @db.Decimal(14, 2)
  impuesto         Decimal?           @db.Decimal(14, 2)
  reajuste         Decimal?           @db.Decimal(14, 2)
  interes          Decimal?           @db.Decimal(14, 2)
  gastosAdmin      Decimal?           @map("gastos_admin") @db.Decimal(14, 2)
  totalPeriodo     Decimal            @map("total_periodo") @db.Decimal(14, 2)
  montoPagado      Decimal            @default(0) @map("monto_pagado") @db.Decimal(14, 2)
  saldo            Decimal            @default(0) @db.Decimal(14, 2)
  estado           EstadoConciliacion @default(PENDIENTE)
  observacion      String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  requerimiento Requerimiento @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  declaracion   Declaracion?   @relation(fields: [declaracionId], references: [id], onDelete: SetNull)

  @@unique([requerimientoId, periodoAnio, trimestreDesde, trimestreHasta])
  @@index([requerimientoId])
  @@index([declaracionId])
  @@index([periodoAnio])
  @@index([estado])
  @@map("requerimientos_detalle")
}


model RequerimientoManual {
  id                              Int                        @id @default(autoincrement())
  anioGestion                     Int                        @map("anio_gestion")
  numeroRequerimiento             String                     @map("numero_requerimiento") @db.VarChar(60)
  correlativoExcel                Int?                       @map("correlativo_excel")
  placaOriginal                   String?                    @map("placa_original") @db.VarChar(40)
  placaNormalizada                String?                    @map("placa_normalizada") @db.VarChar(20)
  fechaRequerimiento              DateTime?                  @map("fecha_requerimiento") @db.Date
  anioVehiculoOriginal            String?                    @map("anio_vehiculo_original") @db.VarChar(60)
  anioVehiculo                    Int?                       @map("anio_vehiculo")
  deudaOriginal                   String?                    @map("deuda_original")
  propietarioOriginal             String?                    @map("propietario_original") @db.VarChar(300)
  estadoManualOriginal            String?                    @map("estado_manual_original") @db.VarChar(250)
  provinciaOriginal               String?                    @map("provincia_original") @db.VarChar(150)
  distritoOriginal                String?                    @map("distrito_original") @db.VarChar(150)
  direccionOriginal               String?                    @map("direccion_original")
  notificadorOriginal             String?                    @map("notificador_original") @db.VarChar(150)
  observacionesOriginal           String?                    @map("observaciones_original")
  numeroLiquidacionDeudaOriginal  String?                    @map("numero_liquidacion_deuda_original") @db.VarChar(100)
  fechaNotificacionOriginal       DateTime?                  @map("fecha_notificacion_original") @db.Date
  numeroCedulonOriginal           String?                    @map("numero_cedulon_original") @db.VarChar(150)
  responsableOriginal             String?                    @map("responsable_original") @db.VarChar(150)
  tipoRegistro                    TipoRegistroManual         @default(INCOMPLETO) @map("tipo_registro")
  estadoConciliado                EstadoConciliacionManual   @default(REVISAR) @map("estado_conciliado")
  estadoRevision                  EstadoRevisionManual       @default(PENDIENTE) @map("estado_revision")
  estadoNotificacion              EstadoNotificacionManual   @default(SIN_ASIGNAR) @map("estado_notificacion")
  notificadorActual               String?                    @map("notificador_actual") @db.VarChar(150)
  responsableActual               String?                    @map("responsable_actual") @db.VarChar(150)
  numeroLiquidacionDeudaActual    String?                    @map("numero_liquidacion_deuda_actual") @db.VarChar(100)
  fechaNotificacionActual         DateTime?                  @map("fecha_notificacion_actual") @db.Date
  numeroCedulonActual             String?                    @map("numero_cedulon_actual") @db.VarChar(150)
  observacionSeguimiento          String?                    @map("observacion_seguimiento")
  archivoOrigen                   String?                    @map("archivo_origen")
  filaOrigen                      Int?                       @map("fila_origen")
  datosOriginales                 Json?                      @map("datos_originales")
  importacionId                   Int?                       @map("importacion_id")
  versionRequerimientosManualesId Int?                       @map("version_requerimientos_manuales_id")
  createdAt                       DateTime                   @default(now()) @map("created_at")
  updatedAt                       DateTime                   @updatedAt @map("updated_at")

  importacion                   Importacion?                    @relation(fields: [importacionId], references: [id], onDelete: SetNull)
  versionRequerimientosManuales VersionRequerimientosManuales? @relation(fields: [versionRequerimientosManualesId], references: [id], onDelete: SetNull)
  periodos                      RequerimientoManualPeriodo[]
  seguimientos                  SeguimientoRequerimientoManual[]
  historial                     HistorialRequerimientoManual[]

  @@unique([anioGestion, numeroRequerimiento])
  @@index([placaNormalizada])
  @@index([fechaRequerimiento])
  @@index([tipoRegistro])
  @@index([estadoConciliado])
  @@index([estadoRevision])
  @@index([estadoNotificacion])
  @@index([notificadorActual])
  @@index([responsableActual])
  @@index([importacionId])
  @@index([versionRequerimientosManualesId])
  @@map("requerimientos_manuales")
}

model RequerimientoManualPeriodo {
  id                    Int                      @id @default(autoincrement())
  requerimientoManualId Int                      @map("requerimiento_manual_id")
  declaracionId         Int?                     @map("declaracion_id")
  periodoAnio           Int                      @map("periodo_anio")
  estadoConciliado      EstadoConciliacionManual @default(REVISAR) @map("estado_conciliado")
  montoPagado           Decimal                  @default(0) @map("monto_pagado") @db.Decimal(14, 2)
  observacion           String?
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  requerimientoManual RequerimientoManual @relation(fields: [requerimientoManualId], references: [id], onDelete: Cascade)
  declaracion         Declaracion?         @relation(fields: [declaracionId], references: [id], onDelete: SetNull)

  @@unique([requerimientoManualId, periodoAnio])
  @@index([requerimientoManualId])
  @@index([declaracionId])
  @@index([periodoAnio])
  @@index([estadoConciliado])
  @@map("requerimientos_manuales_periodos")
}

model SeguimientoRequerimientoManual {
  id                           Int                      @id @default(autoincrement())
  requerimientoManualId        Int                      @map("requerimiento_manual_id")
  usuarioId                    Int?                     @map("usuario_id")
  estadoNotificacion           EstadoNotificacionManual @map("estado_notificacion")
  notificador                  String?                  @db.VarChar(150)
  responsable                  String?                  @db.VarChar(150)
  numeroLiquidacionDeuda       String?                  @map("numero_liquidacion_deuda") @db.VarChar(100)
  fechaNotificacion            DateTime?                @map("fecha_notificacion") @db.Date
  numeroCedulon                String?                  @map("numero_cedulon") @db.VarChar(150)
  observacion                  String?
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  requerimientoManual RequerimientoManual @relation(fields: [requerimientoManualId], references: [id], onDelete: Cascade)
  usuario             Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([requerimientoManualId, createdAt])
  @@index([usuarioId])
  @@index([estadoNotificacion])
  @@map("seguimientos_requerimientos_manuales")
}

model HistorialRequerimientoManual {
  id                    Int      @id @default(autoincrement())
  requerimientoManualId Int      @map("requerimiento_manual_id")
  usuarioId             Int?     @map("usuario_id")
  accion                String   @db.VarChar(100)
  campo                 String?  @db.VarChar(120)
  valorAnterior         String?  @map("valor_anterior")
  valorNuevo            String?  @map("valor_nuevo")
  motivo                String?
  detalles              Json?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  requerimientoManual RequerimientoManual @relation(fields: [requerimientoManualId], references: [id], onDelete: Cascade)
  usuario             Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([requerimientoManualId, createdAt])
  @@index([usuarioId])
  @@index([accion])
  @@map("historial_requerimientos_manuales")
}

model Declaracion {
  id                 Int                @id @default(autoincrement())
  anioDeclaracion    Int                @map("anio_declaracion")
  numeroDeclaracion  String             @map("numero_declaracion") @db.VarChar(60)
  anioRecepcion      Int?               @map("anio_recepcion")
  numeroRecepcion    String?            @map("numero_recepcion") @db.VarChar(60)
  contribuyenteId    Int?               @map("contribuyente_id")
  dniRuc             String?            @map("dni_ruc") @db.VarChar(30)
  nombresRazonSocial String?            @map("nombres_razon_social") @db.VarChar(250)
  direccionFiscal    String?            @map("direccion_fiscal")
  placa              String?            @db.VarChar(20)
  fechaInscripcion   DateTime?          @map("fecha_inscripcion") @db.Date
  anioFabricacion    Int?               @map("anio_fabricacion")
