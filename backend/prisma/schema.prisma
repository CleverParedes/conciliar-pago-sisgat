  contenidoOriginal               Bytes    @map("contenido_original")
  tamanoOriginal                  Int      @map("tamano_original")
  totalFilas                      Int      @default(0) @map("total_filas")
  filasValidas                    Int      @default(0) @map("filas_validas")
  filasConError                   Int      @default(0) @map("filas_con_error")
  resumen                         Json?
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version VersionRequerimientosManuales      @relation(fields: [versionRequerimientosManualesId], references: [id], onDelete: Cascade)
  errores ErrorArchivoRequerimientoManual[]

  @@index([hashArchivo])
  @@map("archivos_version_requerimientos_manuales")
}

model ErrorArchivoRequerimientoManual {
  id              Int      @id @default(autoincrement())
  archivoId       Int      @map("archivo_id")
  fila            Int?
  campo           String?  @db.VarChar(120)
  nivel           String   @default("ERROR") @db.VarChar(20)
  mensaje         String
  datosOriginales Json?    @map("datos_originales")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  archivo ArchivoVersionRequerimientosManuales @relation(fields: [archivoId], references: [id], onDelete: Cascade)

  @@index([archivoId, fila])
  @@index([nivel])
  @@map("errores_archivo_requerimiento_manual")
}

enum RolUsuario {
  USUARIO
  ADMINISTRADOR
}

enum EstadoUsuario {
  ACTIVO
  BLOQUEADO
  DESACTIVADO
}

enum TipoSesion {
  INVITADO
  AUTENTICADO
}

enum EstadoSesion {
  ACTIVA
  REVOCADA
  EXPIRADA
}

model Usuario {
  id               Int           @id @default(autoincrement())
  nombre           String        @db.VarChar(150)
  nombreUsuario    String        @unique @map("nombre_usuario") @db.VarChar(80)
  correo           String?       @unique @db.VarChar(180)
  passwordHash     String        @map("password_hash") @db.VarChar(255)
  rol              RolUsuario    @default(USUARIO)
  estado           EstadoUsuario @default(ACTIVO)
  intentosFallidos Int           @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?     @map("bloqueado_hasta") @db.Timestamptz(3)
  ultimoAcceso     DateTime?     @map("ultimo_acceso") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sesiones               Sesion[]
  auditorias             Auditoria[]
  importaciones          Importacion[]
  versionesDatos          VersionDatos[]
  versionesOrdenes        VersionOrdenes[]
  versionesPagosSisgat    VersionPagosSisgat[]
  versionesLiquidaciones  VersionLiquidaciones[]
  versionesRequerimientos         VersionRequerimientos[]
  versionesRequerimientosManuales VersionRequerimientosManuales[]
  seguimientosRequerimientosManuales SeguimientoRequerimientoManual[]
  historialRequerimientosManuales    HistorialRequerimientoManual[]

  @@index([rol, estado])
  @@map("usuarios")
}

model Sesion {
  id              String       @id @default(uuid()) @db.Uuid
  tokenHash       String       @unique @map("token_hash") @db.VarChar(64)
  tipo            TipoSesion
  estado          EstadoSesion @default(ACTIVA)
  usuarioId       Int?         @map("usuario_id")
  fechaExpira     DateTime     @map("fecha_expira") @db.Timestamptz(3)
  ultimaActividad DateTime     @default(now()) @map("ultima_actividad") @db.Timestamptz(3)
  ip              String?      @db.VarChar(64)
  userAgent       String?      @map("user_agent") @db.VarChar(500)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario    Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  auditorias Auditoria[]

  @@index([usuarioId, estado])
  @@index([tipo, estado])
  @@index([fechaExpira])
  @@map("sesiones")
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int?     @map("usuario_id")
  sesionId  String?  @map("sesion_id") @db.Uuid
  accion    String   @db.VarChar(100)
  entidad   String?  @db.VarChar(100)
  entidadId String?  @map("entidad_id") @db.VarChar(100)
  resultado String   @default("CORRECTO") @db.VarChar(30)
  detalles  Json?
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  sesion  Sesion?  @relation(fields: [sesionId], references: [id], onDelete: SetNull)

  @@index([usuarioId, createdAt])
  @@index([sesionId])
  @@index([accion, createdAt])
  @@map("auditoria")
}